<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- net9 e non net10: il runtime desktop piu' recente in circolazione e' il 9 -->
    <TargetFramework>net9.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>MhxrPatcher</AssemblyName>
    <Version>1.0.0</Version>
    <!-- Icona del file .exe (quella che si vede in Esplora risorse e nella
         barra delle applicazioni). Il PNG originale e' stato convertito in
         .ico con le 7 risoluzioni standard (16-256px). -->
    <ApplicationIcon>app.ico</ApplicationIcon>
  </PropertyGroup>

  <!-- Impostazioni per la pubblicazione "autonoma": un solo .exe che contiene
       anche il .NET, cosi' chi lo scarica non deve installare niente a parte
       il JDK di Java (che serve per firmare l'APK). -->
  <PropertyGroup>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <!-- Il taglio del codice inutilizzato NON va attivato: WinForms costruisce
         le finestre per riflessione e il trimming rimuoverebbe pezzi che
         servono, con errori che compaiono solo a programma avviato. -->
    <PublishTrimmed>false</PublishTrimmed>
  </PropertyGroup>

  <ItemGroup>
    <!-- apksigner.jar (da Android SDK build-tools, strumento ufficiale
         Google): firma con schema v2/v3, non solo v1/jarsigner. Incorporato
         per avere un file solo, l'utente non deve
         installare l'SDK Android, gli basta il JDK che gli serve gia'. -->
    <EmbeddedResource Include="apksigner.jar" LogicalName="MhxrPatcher.apksigner.jar" />
    <!-- apktool (da iBotPeaches/Apktool, licenza Apache 2.0): serve solo per
         aggiungere android:usesCleartextTraffic="true" al manifest quando
         manca (scoperto vero su un APK scaricata da APKPure: senza quel
         permesso Android 9+ blocca ogni richiesta HTTP in chiaro, a
         prescindere da quale indirizzo sia scritto in libMHS.so — il gioco
         non manda mai un solo pacchetto). Non e' un'operazione che si possa
         fare con un find-and-replace di byte come per l'indirizzo: il
         manifest e' XML binario, serve decodificarlo e ricostruirlo davvero. -->
    <EmbeddedResource Include="apktool.jar" LogicalName="MhxrPatcher.apktool.jar" />
    <!-- Risorse della piattaforma Android (framework 1.apk) che apktool
         normalmente scarica da solo al primo utilizzo: incorporata anche
         questa cosi' il decode del manifest funziona anche offline, o su un
         PC dietro un firewall che blocca il download automatico. -->
    <EmbeddedResource Include="apktool-framework.apk" LogicalName="MhxrPatcher.apktool-framework.apk" />
    <!-- Sfondo della finestra: gia' preparato a bassa opacita' (sfondo
         trasparente, drago sbiadito), non va rischiarito ulteriormente a
         runtime. -->
    <EmbeddedResource Include="sfondo.png" LogicalName="MhxrPatcher.sfondo.png" />
  </ItemGroup>

</Project>
